generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  CONTENT_EDITOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentBlockType {
  HEADING
  PARAGRAPH
  BULLET_LIST
  QUOTE
  CASE
  STATUTE
  CITATION
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(STUDENT)
  avatarUrl    String?
  isActive     Boolean      @default(true)
  enrollments  Enrollment[]
  questions    Question[]
  replies      Reply[]
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id           String       @id @default(uuid())
  code         String       @unique
  title        String
  academicYear Int
  semester     Int
  status       ContentStatus @default(DRAFT)
  topics       Topic[]
  enrollments  Enrollment[]
  questions    Question[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Topic {
  id           String         @id @default(uuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  position     Int
  status       ContentStatus  @default(DRAFT)
  sourceFile   String?
  notes        Note[]
  cases        LegalCase[]
  statutes     Statute[]
  sections     TopicSection[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([courseId, position])
}

model TopicSection {
  id        String               @id @default(uuid())
  topicId   String
  topic     Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  blocks    TopicContentBlock[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([topicId, position])
}

model TopicContentBlock {
  id         String          @id @default(uuid())
  sectionId  String
  section    TopicSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type       ContentBlockType
  position   Int
  text       String
  citation   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sectionId, position])
}

model Note {
  id        String        @id @default(uuid())
  topicId   String
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  content   String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model LegalCase {
  id            String        @id @default(uuid())
  topicId       String
  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title         String
  citation      String
  court         String?
  decisionYear  Int?
  facts         String?
  issue         String?
  holding       String?
  principle     String
  isLeadingCase Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Statute {
  id        String        @id @default(uuid())
  topicId   String
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  section   String?
  content   String?
  sourceUrl String?
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Enrollment {
  id                       String   @id @default(uuid())
  userId                   String
  courseId                 String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedTopicIds        String[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([userId, courseId])
}

model Question {
  id        String   @id @default(uuid())
  courseId  String
  authorId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isLocked  Boolean  @default(false)
  replies   Reply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id         String   @id @default(uuid())
  questionId String
  authorId   String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsArticle {
  id          String        @id @default(uuid())
  title       String
  summary     String
  content     String?
  imageUrl    String?
  sourceUrl   String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
